# Copy this file to ".env" and fill in what you need. ".env" is git-ignored.

# --- API key (public data: videos, channels, playlists, comments, search...) ---
# Google Cloud Console > APIs & Services > Credentials > Create credentials > API key
# Also enable "YouTube Data API v3" for the project.
YOUTUBE_API_KEY=

# --- OAuth client (private data + writes + YouTube Analytics) ---
# Credentials > Create credentials > OAuth client ID > "Web application"
# Authorized redirect URI:  http://localhost:3000/auth/callback
# Also enable "YouTube Analytics API" if you want the Analytics tab to work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---
# PORT=3000
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Refuse every non-GET request on the server side (extra safety net while exploring).
# READ_ONLY=true

# Override the daily limits the local quota meter compares against
# (check the Quotas page in Google Cloud Console for your project's real numbers).
# QUOTA_GENERAL=10000
# QUOTA_SEARCH=100
# QUOTA_UPLOAD=100
# QUOTA_BATCH_STATS=10000

# Point the playground at a mock server instead of Google (used by the tests).
# YT_DATA_BASE=https://www.googleapis.com/youtube/v3
# YT_ANALYTICS_BASE=https://youtubeanalytics.googleapis.com/v2
